function hit(id, shapes){
  return '<g class="hit" data-id="'+id+'" tabindex="0" role="button" pointer-events="all" fill="transparent">'+shapes+'</g>';
}

/* ---------------- part two engine ---------------- */
function drawView(){
  var f = $('#flipper');
  f.innerHTML = (S.view === 'side') ? sideSVG() : planSVG();
  $('#viewname').textContent = (S.view === 'side') ? 'Side elevation' : 'Plan view';
  /* restore callouts already earned in this view */
  PARTS.forEach(function(p){ if(S.found[p.id] && p.v === S.view) addCallout(p, S.found[p.id]); });
  var hits = f.querySelectorAll('.hit');
  Array.prototype.forEach.call(hits, function(h){
    h.addEventListener('click', function(){ p2Answer(h.dataset.id); });
    h.addEventListener('keydown', function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); p2Answer(h.dataset.id); }
    });
  });
}

function addCallout(p, ok){
  var host = $('#flipper').querySelector('.callouts');
  if(!host) return;
  var col = ok ? C.jet : C.warp;
  var anchor = p.lx < 200 ? 'start' : (p.lx > 720 ? 'end' : 'middle');
  var g = document.createElementNS(SVGNS, 'g');
  g.setAttribute('opacity','0');
  g.innerHTML =
      '<line x1="'+p.px+'" y1="'+p.py+'" x2="'+p.lx+'" y2="'+p.ly+'" stroke="'+col+'" stroke-width="1" opacity=".55"/>'
    + '<circle cx="'+p.px+'" cy="'+p.py+'" r="3" fill="'+col+'"/>'
    + '<text x="'+p.lx+'" y="'+p.ly+'" text-anchor="'+anchor+'" font-family="Barlow Condensed, sans-serif" '
    + 'font-weight="600" font-size="15" letter-spacing="1.6" fill="'+col+'">'+p.n.toUpperCase()+'</text>';
  host.appendChild(g);
  requestAnimationFrame(function(){
    g.style.transition = 'opacity .45s';
    g.setAttribute('opacity','1');
  });
}

function flipTo(view, then){
  if(S.flipping) return;
  S.flipping = true;
  var f = $('#flipper');
  f.classList.add('spin');
  setTimeout(function(){
    S.view = view;
    drawView();
    f.classList.remove('spin');
    S.flipping = false;
    if(then) then();
  }, 620);
}

function p2Question(){
  if(S.q >= PARTS.length) return endGame(true);
  var p = PARTS[S.q];
  S.locked = false;
  $('#p2label').textContent = 'Part ' + (S.q+1) + ' of ' + PARTS.length;
  $('#p2term').textContent = '';
  $('#p2sub').textContent = p.q;
  var note = $('#n2');
  note.className = 'note';
  note.textContent = 'Click the part on the machine.';

  var ask = function(){
    $('#p2term').textContent = 'Name it';
    runTimer('#t2', T2, function(){ p2Answer(null); });
  };
  if(p.v !== S.view){
    note.textContent = 'The machine turns.';
    flipTo(p.v, ask);
  } else ask();
}

function p2Answer(id){
  if(S.locked || S.flipping) return;
  var p = PARTS[S.q];
  if(id && id !== p.id){
    /* wrong click: name what was actually clicked, then move on */
    S.locked = true; stopTimer();
    var other = null;
    PARTS.forEach(function(x){ if(x.id === id) other = x; });
    bumpEff(-12);
    $('#p2term').textContent = p.n;
    var n = $('#n2'); n.className = 'note bad';
    n.textContent = (other ? 'That is the ' + other.n.toLowerCase() + '. ' : 'Not that one. ') + p.k;
    S.found[p.id] = false;
    addCallout(p, false);
    S.misses.push({w:'Part 2', n:p.n, k:p.k});
    if(S.eff <= 0) return setTimeout(function(){ endGame(false); }, 1500);
    S.q++;
    return setTimeout(p2Question, 2600);
  }
  if(!id){
    S.locked = true; stopTimer();
    bumpEff(-14);
    $('#p2term').textContent = p.n;
    var n2 = $('#n2'); n2.className = 'note bad';
    n2.textContent = 'Ran out. ' + p.k;
    S.found[p.id] = false;
    addCallout(p, false);
    S.misses.push({w:'Part 2', n:p.n, k:p.k});
    if(S.eff <= 0) return setTimeout(function(){ endGame(false); }, 1500);
    S.q++;
    return setTimeout(p2Question, 2600);
  }
  /* correct */
  S.locked = true; stopTimer();
  var snap = elapsed() < SNAP;
  bumpEff(snap ? 12 : 4);
  $('#p2term').textContent = p.n;
  var n3 = $('#n2'); n3.className = 'note good';
  n3.textContent = p.k + (snap ? '  ·  Snap bonus.' : '');
  S.found[p.id] = true;
  addCallout(p, true);
  S.q++;
  setTimeout(p2Question, 1900);
}

/* ---------------- flow ---------------- */
function show(id){
  Array.prototype.forEach.call(document.querySelectorAll('.screen'), function(s){ s.classList.remove('on'); });
  $(id).classList.add('on');
  window.scrollTo(0,0);
}

function toIntermission(){
  stopTimer();
  var wrong = S.misses.length;
  bumpEff(20);
  $('#midtext').textContent = wrong === 0
    ? 'Eighteen settings, none of them missed. The panel is yours — you could walk up to a Navi-Board cold and read it.'
    : 'Eighteen settings, ' + wrong + ' of them wrong. Efficiency is holding at ' + Math.round(S.eff)
      + '%. The misses come back at the end of the shift.';
  S.part = 2; S.q = 0;
  show('#s-mid');
}

function startPart2(){
  S.q = 0; S.view = 'side'; S.found = {};
  show('#s-p2');
  $('#g2').innerHTML = gaugeSVG();
  paintGauge($('#g2'));
  drawView();
  setTimeout(p2Question, 320);
}

function endGame(finished){
  stopTimer();
  var eff = Math.round(S.eff), miss = S.misses.length, total = DIALS.length + PARTS.length;
  var v, tx;
  if(!finished){
    v = 'Loom stopped';
    tx = 'Efficiency hit zero at question ' + (S.q+1) + ' of ' + total + '. In a real shed that is a weaver on the wrong machine — which is exactly what the training is for. The terms you fumbled are below.';
  } else if(miss === 0){
    v = 'Full efficiency';
    tx = 'Every setting and every part, clean, finishing at ' + eff + '%. You could take a shift on a JAT910 and know what you were looking at.';
  } else if(miss <= 5){
    v = 'Running well';
    tx = 'Finished at ' + eff + '% with ' + miss + ' term' + (miss>1?'s':'') + ' fumbled out of ' + total + '. That is a mill running above its target.';
  } else if(miss <= 12){
    v = 'Stop marks';
    tx = 'Finished at ' + eff + '% with ' + miss + ' fumbles out of ' + total + '. The vocabulary is landing, but the timing diagram is still slippery.';
  } else {
    v = 'Back to the manual';
    tx = 'Finished at ' + eff + '% with ' + miss + ' fumbles out of ' + total + '. Worth another run — the numbers stick faster the second time.';
  }
  $('#verdict').textContent = v;
  $('#endtext').textContent = tx;
  var list = $('#misslist');
  list.innerHTML = '';
  if(miss === 0){
    list.innerHTML = '<div class="missrow"><span>CLEAN</span><div><b>Nothing to review.</b></div></div>';
  } else {
    S.misses.forEach(function(m){
      var row = ce('div');
      row.className = 'missrow';
      row.innerHTML = '<span>'+m.w.toUpperCase()+'</span><div><b>'+m.n+'</b><i>'+m.k+'</i></div>';
      list.appendChild(row);
    });
  }
  show('#s-end');
}

function reset(){
  stopTimer();
  S.eff = 100; S.q = 0; S.misses = []; S.part = 1;
  S.view = 'side'; S.found = {}; S.locked = false; S.flipping = false;
  $('#p1log').innerHTML = '';
  $('#g1').innerHTML = gaugeSVG();
  paintGauge($('#g1'));
  show('#s-p1');
  p1Question();
}

/* ---------------- wiring ---------------- */
function boot(){
  $('#go').addEventListener('click', reset);
  $('#go2').addEventListener('click', startPart2);
  $('#again').addEventListener('click', function(){
    S.eff = 100; S.misses = []; S.q = 0; S.found = {};
    $('#p1log').innerHTML = '';
    show('#s-intro');
  });
  $('#flip').addEventListener('click', function(){
    if(S.flipping) return;
    flipTo(S.view === 'side' ? 'plan' : 'side');
  });
}
if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
else boot();

/* expose for headless testing */
window.__LOOM__ = {S:S, DIALS:DIALS, PARTS:PARTS, buildDial:buildDial, gaugeSVG:gaugeSVG, p1Answer:p1Answer, p2Answer:p2Answer,
                   reset:reset, startPart2:startPart2, sideSVG:sideSVG, planSVG:planSVG};
})();
</script>
