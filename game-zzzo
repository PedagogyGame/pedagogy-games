<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Picks Per Minute — Air-Jet Loom Trainer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#06080b;
    --panel:#0f151d;
    --panel2:#161f2a;
    --edge:#22303f;
    --jet:#6fe0f0;        /* compressed air */
    --warp:#d9a44b;       /* warp yarn brass */
    --weft:#ff7a4d;       /* weft yarn */
    --good:#7fd68a;
    --alarm:#d94f36;
    --bone:#ebe7dd;
    --dim:#6f7c8a;
    --hair:rgba(111,224,240,.14);
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:var(--void);
    color:var(--bone);
    font-family:'Barlow',system-ui,sans-serif;
    -webkit-text-size-adjust:100%;
    overflow:hidden;
  }
  /* the void: a slow drift of warp lines, nothing else */
  body::before{
    content:"";position:fixed;inset:-20%;pointer-events:none;z-index:0;
    background-image:linear-gradient(90deg,var(--hair) 1px,transparent 1px);
    background-size:52px 100%;
    opacity:.5;
    transform:skewX(-6deg);
  }
  body::after{
    content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
    background:radial-gradient(ellipse 70% 55% at 50% 45%,rgba(111,224,240,.06),transparent 70%);
  }
  .screen{position:fixed;inset:0;display:none;overflow:auto;-webkit-overflow-scrolling:touch;z-index:1}
  .screen.on{display:block}

  .eyebrow{
    font-family:'Share Tech Mono',monospace;font-size:11px;letter-spacing:.28em;
    text-transform:uppercase;color:var(--jet);opacity:.85;
  }
  h1{
    font-family:'Barlow Condensed',sans-serif;font-weight:700;
    font-size:clamp(38px,8vw,74px);line-height:.92;letter-spacing:.02em;
    margin:.18em 0 .1em;text-transform:uppercase;
  }
  h1 .thin{font-weight:500;color:var(--jet)}
  h2{
    font-family:'Barlow Condensed',sans-serif;font-weight:600;text-transform:uppercase;
    letter-spacing:.06em;font-size:clamp(22px,4.6vw,34px);margin:0 0 .3em;
  }
  p{line-height:1.55;color:#c3c8ce}
  .wrap{max-width:960px;margin:0 auto;padding:clamp(22px,5vw,54px) clamp(18px,5vw,32px)}

  .btn{
    display:inline-block;border:1px solid var(--jet);background:transparent;color:var(--jet);
    font-family:'Barlow Condensed',sans-serif;font-weight:600;text-transform:uppercase;
    letter-spacing:.14em;font-size:16px;padding:13px 30px;cursor:pointer;border-radius:2px;
    transition:background .16s,color .16s;
  }
  .btn:hover,.btn:focus-visible{background:var(--jet);color:var(--void);outline:none}
  .btn.ghost{border-color:var(--edge);color:var(--dim)}
  .btn.ghost:hover,.btn.ghost:focus-visible{background:var(--edge);color:var(--bone)}

  .specrow{display:flex;flex-wrap:wrap;gap:10px 26px;margin:22px 0 8px}
  .spec{font-family:'Share Tech Mono',monospace;font-size:12px;color:var(--dim)}
  .spec b{color:var(--warp);font-weight:400}

  /* ---------- play chrome ---------- */
  .hud{
    position:sticky;top:0;z-index:5;background:linear-gradient(180deg,var(--void) 62%,transparent);
    padding:10px clamp(12px,3vw,22px) 6px;
  }
  .hudline{display:flex;align-items:center;gap:14px;max-width:1180px;margin:0 auto}
  .gauge{flex:0 0 auto}
  .prompt{flex:1 1 auto;min-width:0}
  .plabel{font-family:'Share Tech Mono',monospace;font-size:10.5px;letter-spacing:.24em;color:var(--dim);text-transform:uppercase}
  .pterm{
    font-family:'Barlow Condensed',sans-serif;font-weight:600;text-transform:uppercase;
    letter-spacing:.03em;font-size:clamp(19px,3.5vw,29px);line-height:1.06;margin-top:2px;
  }
  .psub{font-size:13px;color:var(--dim);margin-top:3px;line-height:1.35}
  .timerbar{height:3px;background:var(--edge);margin:8px auto 0;max-width:1180px;border-radius:2px;overflow:hidden}
  .timerbar i{display:block;height:100%;width:100%;background:var(--jet);transform-origin:left;transition:transform .1s linear}
  .timerbar.low i{background:var(--alarm)}

  .stage{max-width:1180px;margin:0 auto;padding:4px clamp(10px,3vw,22px) 26px}
  .stage svg{width:100%;height:auto;display:block;overflow:visible}

  /* ---------- part 1 instrument ---------- */
  .bench{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:22px;align-items:start}
  @media(max-width:820px){.bench{grid-template-columns:1fr}}
  .detent{cursor:pointer}
  .detent .dtouch{fill:transparent}
  .detent:hover .dbox,.detent:focus-visible .dbox{fill:#1d2937;stroke:var(--jet)}
  .detent:focus-visible{outline:none}
  .detent.locked{cursor:default}

  .logbox{
    border:1px solid var(--edge);background:rgba(15,21,29,.6);border-radius:3px;
    padding:12px 13px;max-height:60vh;overflow:auto;
  }
  .logbox h3{
    font-family:'Share Tech Mono',monospace;font-size:10.5px;letter-spacing:.22em;
    color:var(--dim);text-transform:uppercase;margin:0 0 9px;font-weight:400;
  }
  .chip{
    display:flex;justify-content:space-between;gap:10px;
    font-family:'Share Tech Mono',monospace;font-size:11.5px;
    padding:5px 0;border-bottom:1px dotted #1c2733;color:var(--dim);
  }
  .chip b{color:var(--bone);font-weight:400;text-align:right}
  .chip.miss b{color:var(--alarm)}
  .chip.hit b{color:var(--good)}

  .note{
    min-height:42px;margin:10px auto 0;max-width:1180px;padding:9px 13px;
    border-left:2px solid var(--edge);font-size:14px;line-height:1.45;color:var(--dim);
    transition:border-color .2s,color .2s;
  }
  .note.good{border-color:var(--good);color:#b6c9b8}
  .note.bad{border-color:var(--alarm);color:#d8b3aa}

  /* ---------- part 2 machine ---------- */
  .viewbar{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    max-width:1180px;margin:0 auto 8px;padding:0 clamp(10px,3vw,22px);
  }
  .viewtag{font-family:'Share Tech Mono',monospace;font-size:11px;letter-spacing:.2em;color:var(--dim);text-transform:uppercase}
  .viewtag b{color:var(--jet);font-weight:400}
  .flipwrap{perspective:1600px}
  .flipper{transition:transform .62s cubic-bezier(.6,.02,.3,1);transform-style:preserve-3d}
  .flipper.spin{transform:rotateY(90deg)}
  .hit{cursor:pointer;fill:transparent;stroke:transparent}
  .hit:focus-visible{outline:none;stroke:var(--jet);stroke-width:2;stroke-dasharray:4 3}
  @media(hover:hover){.hit:hover{stroke:rgba(111,224,240,.5);stroke-width:1.5;stroke-dasharray:3 3}}

  /* ---------- end ---------- */
  .verdict{font-family:'Barlow Condensed',sans-serif;font-weight:700;text-transform:uppercase;
    font-size:clamp(30px,6vw,54px);line-height:1;letter-spacing:.02em;margin:.1em 0 .25em}
  .misslist{margin:18px 0 26px;border-top:1px solid var(--edge)}
  .missrow{display:flex;gap:14px;padding:9px 0;border-bottom:1px solid #131c25;font-size:14px;line-height:1.4}
  .missrow span{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--warp);
    flex:0 0 78px;letter-spacing:.08em;padding-top:2px}
  .missrow b{font-weight:600;color:var(--bone)}
  .missrow i{font-style:normal;color:var(--dim);display:block;margin-top:2px}

  @media (prefers-reduced-motion:reduce){
    *{animation-duration:.001s!important;transition-duration:.001s!important}
  }
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>
</head>
<body>

<!-- ============ INTRO ============ -->
<div class="screen on" id="s-intro">
  <div class="wrap">
    <div class="eyebrow">Pneumatic weft insertion &middot; shuttleless</div>
    <h1>Picks Per<br><span class="thin">Minute</span></h1>
    <p style="max-width:60ch;font-size:16.5px">
      A modern air-jet loom throws the weft across four metres of shed on nothing but a pulse of
      compressed air, then does it again fifteen hundred times a minute. Nothing solid crosses the
      cloth. There is no shuttle to catch.
    </p>
    <p style="max-width:60ch">
      Two parts. First the control panel &mdash; eighteen settings, learned as numbers on a dial,
      because on this machine the numbers <em>are</em> the machine. Then the loom itself, from the
      side and from above, and you name the parts.
    </p>
    <div class="specrow">
      <div class="spec">SPEED <b>700&ndash;1500 rpm</b></div>
      <div class="spec">INSERTION <b>&gt;2650 m/min</b></div>
      <div class="spec">REED SPACE <b>150&ndash;390 cm</b></div>
      <div class="spec">CYCLE <b>360&deg;</b></div>
    </div>
    <p style="font-size:13.5px;color:var(--dim);max-width:56ch">
      Efficiency starts at 100%. A wrong setting costs 12, a run-out costs 14, and answering inside
      six seconds pays a snap bonus. Drop to zero and the shed stays shut.
    </p>
    <div style="margin-top:26px">
      <button class="btn" id="go">Start Part One</button>
    </div>
  </div>
</div>

<!-- ============ PART ONE ============ -->
<div class="screen" id="s-p1">
  <div class="hud">
    <div class="hudline">
      <div class="gauge" id="g1"></div>
      <div class="prompt">
        <div class="plabel" id="p1label">Setting 1 of 18</div>
        <div class="pterm" id="p1term"></div>
        <div class="psub" id="p1sub"></div>
      </div>
    </div>
    <div class="timerbar" id="t1"><i></i></div>
  </div>
  <div class="stage">
    <div class="bench">
      <div id="dialhost"></div>
      <div class="logbox">
        <h3>Machine settings</h3>
        <div id="p1log"></div>
      </div>
    </div>
  </div>
  <div class="note" id="n1">Turn the dial to the correct value.</div>
</div>

<!-- ============ INTERMISSION ============ -->
<div class="screen" id="s-mid">
  <div class="wrap">
    <div class="eyebrow">Part one complete</div>
    <h2 id="midhead">Panel signed off</h2>
    <p id="midtext" style="max-width:58ch"></p>
    <p style="max-width:58ch">
      Now the machine. You'll see it from the side first &mdash; the warp path, the shed, the beat-up
      &mdash; then it turns and you look down the sley at the insertion channel itself.
    </p>
    <div style="margin-top:24px">
      <button class="btn" id="go2">Start Part Two</button>
    </div>
  </div>
</div>

<!-- ============ PART TWO ============ -->
<div class="screen" id="s-p2">
  <div class="hud">
    <div class="hudline">
      <div class="gauge" id="g2"></div>
      <div class="prompt">
        <div class="plabel" id="p2label">Part 1 of 22</div>
        <div class="pterm" id="p2term"></div>
        <div class="psub" id="p2sub"></div>
      </div>
    </div>
    <div class="timerbar" id="t2"><i></i></div>
  </div>
  <div class="viewbar">
    <div class="viewtag">View &middot; <b id="viewname">Side elevation</b></div>
    <button class="btn ghost" id="flip" style="font-size:13px;padding:7px 16px">Turn the machine</button>
  </div>
  <div class="stage">
    <div class="flipwrap"><div class="flipper" id="flipper"></div></div>
  </div>
  <div class="note" id="n2">Click the part on the machine.</div>
</div>

<!-- ============ END ============ -->
<div class="screen" id="s-end">
  <div class="wrap">
    <div class="eyebrow" id="endeyebrow">Shift report</div>
    <div class="verdict" id="verdict"></div>
    <p id="endtext" style="max-width:58ch;font-size:16px"></p>
    <div class="misslist" id="misslist"></div>
    <button class="btn" id="again">Run it again</button>
  </div>
</div>

<script>
/* ============================================================
   PICKS PER MINUTE — air-jet loom trainer
   Part 1: the control panel.  Part 2: the machine.
   ============================================================ */
(function(){
'use strict';

var $  = function(s){ return document.querySelector(s); };
var ce = function(t){ return document.createElement(t); };
var SVGNS = 'http://www.w3.org/2000/svg';
var TAU = Math.PI*2;
var rad = function(d){ return d*Math.PI/180; };

/* ---------------- state ---------------- */
var S = {
  eff: 100,          // machine efficiency %
  q: 0,
  timer: null,
  tick: null,
  started: 0,
  locked: false,
  misses: [],
  part: 1,
  view: 'side',
  found: {},
  flipping: false
};
var LIMIT = 150, T1 = 20000, T2 = 16000, SNAP = 6000;

/* ---------------- part one: the settings ---------------- */
/* type 'arc'   → 240° pressure/speed scale, options ascending
   type 'crank' → 360° crank-angle wheel, options are angles or [from,to] spans */
var DIALS = [
 {n:'Loom speed', u:'rpm', t:'arc',
  q:'What does an air-jet loom run at in normal production?',
  o:['150–300','700–1500','3000–4000','8000–10000'], c:1,
  k:'700 to 1500 rpm on the shop floor. Tsudakoma have demonstrated a ZAX9100 at 1900 rpm, but that is an exhibition number, not a shift.'},

 {n:'Weft insertion rate', u:'m/min', t:'arc',
  q:'How much yarn crosses the shed per minute?',
  o:['80','400','over 2650','over 40 000'], c:2,
  k:'Over 2650 m/min, and up to 5000 in double-picking configurations. That is roughly forty metres of yarn every second.'},

 {n:'Main nozzle inlet', u:'bar', t:'arc',
  q:'What gauge pressure feeds the main nozzle?',
  o:['0.4–0.8','4–8','18–24','60–90'], c:1,
  k:'4 to 8 bar, about 60 to 115 psi. High enough to launch the yarn, low enough that the compressor bill stays survivable.'},

 {n:'Relay pressure · picking side', u:'bar', t:'arc',
  q:'What pressure do the relay nozzles nearest the main nozzle run at?',
  o:['0.2–0.4','2–4','9–12','25–30'], c:1,
  k:'2 to 4 bar. The yarn still carries the momentum the main nozzle gave it, so this end of the reed needs the least help.'},

 {n:'Relay pressure · arrival side', u:'bar', t:'arc',
  q:'And at the far end, where the yarn tip is running out of speed?',
  o:['0.3–0.6','3–6.5','14–18','30–40'], c:1,
  k:'3 to 6.5 bar. Pressure climbs across the width because drag has been bleeding energy out of the yarn the whole way.'},

 {n:'Air consumption', u:'m³/min', t:'arc',
  q:'How much compressed air does one machine swallow?',
  o:['0.03–0.06','0.3–0.6','3–6','30–60'], c:1,
  k:'0.3 to 0.6 m³/min each. A hundred looms therefore need more than 40 m³/min of continuous supply — an Atlas Copco ZR-250 or an IHI turbine at 250 kW.'},

 {n:'Compressor line band', u:'bar', t:'arc',
  q:'How tightly does the master controller hold the line pressure?',
  o:['0.2','1.5','4','10'], c:0,
  k:'A 0.2 bar band. Narrowing it drops mean system pressure by 0.3 to 0.7 bar, and every excess bar burns electricity without weaving a single pick.'},

 {n:'Main nozzle opens', u:'crank°', t:'crank',
  q:'At what point in the cycle does the main nozzle start blowing?',
  o:[15,45,95,150], c:1,
  k:'45°. It fires before the yarn is released so the air column is already up to velocity when the weft arrives.'},

 {n:'Stopper pin releases', u:'crank°', t:'crank',
  q:'When does the accumulator let the measured length go?',
  o:[20,80,140,210], c:1,
  k:'80°, thirty-five degrees after the air. The pin holds exactly one pick of coiled yarn, so the loom never drags weft straight off the package.'},

 {n:'First relay group', u:'crank°', t:'crank',
  q:'Over what span does the first bank of relay nozzles fire?',
  o:[[10,40],[86,166],[190,250],[300,340]], c:1,
  k:'86° to 166°. As the tip clears that zone the next group lights and this one dies — a moving wave of air riding the leading end of the yarn.'},

 {n:'Main nozzle closes', u:'crank°', t:'crank',
  q:'When does the main nozzle stop?',
  o:[60,120,200,300], c:1,
  k:'120°. It hands the yarn over to the relays once momentum is established. Blowing longer would only waste air.'},

 {n:'Weft clamp closes', u:'crank°', t:'crank',
  q:'When is further release of weft physically arrested?',
  o:[130,180,230,300], c:2,
  k:'230°. The clamp shuts and no more yarn can leave the drum, which is what fixes the pick length.'},

 {n:'Last relay group closes', u:'crank°', t:'crank',
  q:'When does the final bank of relay nozzles shut off?',
  o:[180,225,260,320], c:2,
  k:'260°, just as the reed comes forward to beat the pick into the fell.'},

 {n:'Sley dwell at back centre', u:'crank°', t:'arc',
  q:'How long does the sley stand still while the weft flies?',
  o:['about 3°','25° or more','about 90°','about 180°'], c:1,
  k:'25° or more, which is why the sley is driven by double conjugated cams instead of a plain crank. A crank never truly stops.'},

 {n:'Pick density', u:'per inch', t:'arc',
  q:'What range of pick densities can be set from the panel?',
  o:['2–8','25–300','500–900','2000+'], c:1,
  k:'25 to over 300 picks per inch, set electronically through the take-up, no change gears to swap.'},

 {n:'Reed space', u:'cm', t:'arc',
  q:'How wide do these machines get?',
  o:['40–90','150–390','600–900','1200–2000'], c:1,
  k:'150 cm for narrow technical cloth up to 390 or 400 cm for wide sheeting. The whole frame scales with it.'},

 {n:'Main drive motor', u:'kW', t:'arc',
  q:'How big is the motor turning the loom?',
  o:['0.5–1','5.5–7.5','55–75','250'], c:1,
  k:'5.5 to 7.5 kW. The 250 kW figure belongs to the compressor feeding a whole shed of looms, not to any one machine.'},

 {n:'Weft colour channels', u:'colours', t:'arc',
  q:'How many separate weft colours can be selected?',
  o:['1','up to 8','up to 32','up to 12 000'], c:1,
  k:'Up to eight, each with its own nozzle and, on a Picanol, its own air tank. The 12 000 figure is jacquard hooks — a different mechanism entirely.'}
];

/* ---------------- part two: the machine ---------------- */
var PARTS = [
 /* --- side elevation --- */
 {id:'warpbeam', v:'side', n:'Warp beam',
  q:'The flanged beam at the back holding thousands of parallel warp ends under tension.',
  k:'800 to 1250 mm across the flanges. An electronic let-off servo turns it against a load cell so tension stays constant as the diameter shrinks.',
  lx:128, ly:492, px:128, py:452},
 {id:'whip', v:'side', n:'Whip roller',
  q:'The sprung back rest the warp passes over, which senses tension and feeds it back to the let-off.',
  k:'Also called the back rest. Its deflection is the signal the let-off servo works from.',
  lx:214, ly:150, px:250, py:216},
 {id:'heald', v:'side', n:'Heald frame',
  q:'The vertical frames carrying wire heddles, raised and lowered to part the warp.',
  k:'Crank shedding for plain weaves, cams for twills, a dobby for up to 24 shafts, a jacquard for 12 000 hooks. Itema set the first frame unusually close to the reed to shorten the stroke.',
  lx:352, ly:64, px:400, py:112},
 {id:'shed', v:'side', n:'Shed',
  q:'The triangular tunnel opened between the two sheets of warp — the only window the weft gets.',
  k:'Everything in air-jet weaving is a fight to keep this tunnel open and still long enough for the yarn to cross it.',
  lx:560, ly:196, px:524, py:246},
 {id:'reed', v:'side', n:'Reed',
  q:'The comb the warp threads pass through, which sweeps forward to pack each new pick home.',
  k:'On an air-jet the dents are machined with a channel cut into their front edge — the profile reed — so the air has a tunnel to travel down.',
  lx:642, ly:150, px:590, py:200},
 {id:'sley', v:'side', n:'Sley',
  q:'The heavy reciprocating beam that carries the reed and every relay nozzle with it.',
  k:'Driven from both ends to stop it twisting, and deliberately made to dwell at back centre while the yarn flies.',
  lx:452, ly:406, px:508, py:378},
 {id:'fell', v:'side', n:'Fell of the cloth',
  q:'The line where the last inserted pick meets the finished fabric.',
  k:'A stop mark is simply the fell relaxing while the machine stands idle. Direct-drive motors and a compensating let-off exist mostly to prevent that one defect.',
  lx:648, ly:216, px:618, py:246},
 {id:'breast', v:'side', n:'Breast beam',
  q:'The fixed roller the new cloth turns over as it leaves the weaving zone.',
  k:'It sets the angle of the cloth line and gives the weaver something to lean on, which is how it got the name.',
  lx:696, ly:214, px:676, py:244},
 {id:'takeup', v:'side', n:'Take-up roller',
  q:'The friction-covered roller drawing the cloth forward at a rate that fixes the pick spacing.',
  k:'Rubber or a synthetic compound, because any slip here shows up in the fabric as a band of wrong pick density.',
  lx:806, ly:314, px:762, py:334},
 {id:'clothroll', v:'side', n:'Cloth roll',
  q:'The wound batch of finished fabric near the floor.',
  k:'On indirect take-up it is driven through a friction roll and free wheel, with a feeler lever on the press roll keeping the winding tension even.',
  lx:800, ly:512, px:800, py:494},
 {id:'cam', v:'side', n:'Conjugated cam',
  q:'The paired cam drive that gives the sley a long pause at the back and a violent strike at the front.',
  k:'A plain crank produces simple harmonic motion with no dwell at all. Two conjugated cams let you draw whatever velocity curve the weft needs.',
  lx:352, ly:498, px:400, py:478},

 /* --- plan view --- */
 {id:'package', v:'plan', n:'Weft package',
  q:'The cross-wound cones in the creel supplying filling yarn to the machine.',
  k:'They sit outside the loom entirely and never move. Nothing solid crosses the cloth on an air-jet.',
  lx:54, ly:96, px:54, py:120},
 {id:'accum', v:'plan', n:'Accumulator',
  q:'The drum that unwinds yarn steadily and stores exactly one pick as coils, ready to release.',
  k:'The pre-winder. Without it the loom would pull straight off the package at 2650 m/min and snap the yarn on the tension spike alone.',
  lx:190, ly:140, px:190, py:168},
 {id:'stopper', v:'plan', n:'Stopper pin',
  q:'The electromagnetic pin holding the measured coils until the instant insertion begins.',
  k:'It retracts at 80° of crank. Everything downstream is timed from that release.',
  lx:288, ly:112, px:250, py:132},
 {id:'balloon', v:'plan', n:'Balloon breaker',
  q:'The ring that collapses the spinning loop of yarn as it comes off the drum.',
  k:'Fitted for coarser yarns. The unwinding balloon would otherwise throw chaotic tension into the pick.',
  lx:272, ly:160, px:272, py:190},
 {id:'tandem', v:'plan', n:'Tandem nozzle',
  q:'The fixed auxiliary jet that pulls yarn off the measuring drum before the main jet takes over.',
  k:'It shares the work: the tandem draws the yarn, the sley-mounted main nozzle supplies the brutal initial acceleration.',
  lx:330, ly:164, px:344, py:194},
