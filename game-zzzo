function paintGauge(host){
  if(!host) return;
  var f = Math.max(0, Math.min(1, S.eff/LIMIT));
  var n = host.querySelector('.gneedle');
  var a = host.querySelector('.garc');
  var t = host.querySelector('.gnum');
  if(n) n.style.transform = 'rotate('+(-90+f*180).toFixed(1)+'deg)';
  if(a){
    a.setAttribute('stroke-dashoffset', (164*(1-f)).toFixed(1));
    a.setAttribute('stroke', S.eff<=35 ? '#d94f36' : (S.eff>=110 ? '#7fd68a' : '#6fe0f0'));
  }
  if(t) t.textContent = Math.round(S.eff);
}
function bumpEff(d){
  S.eff = Math.max(0, Math.min(LIMIT, S.eff + d));
  paintGauge($('#g1')); paintGauge($('#g2'));
}

/* ---------------- timer bar ---------------- */
function runTimer(barSel, ms, onOut){
  clearTimeout(S.timer); clearInterval(S.tick);
  var bar = $(barSel), fill = bar.firstElementChild;
  bar.classList.remove('low');
  fill.style.transition='none'; fill.style.transform='scaleX(1)';
  void fill.offsetWidth;
  S.started = Date.now();
  S.tick = setInterval(function(){
    var left = Math.max(0, 1 - (Date.now()-S.started)/ms);
    fill.style.transition='transform .1s linear';
    fill.style.transform='scaleX('+left.toFixed(3)+')';
    if(left < .28) bar.classList.add('low');
  }, 100);
  S.timer = setTimeout(function(){ clearInterval(S.tick); onOut(); }, ms);
}
function stopTimer(){ clearTimeout(S.timer); clearInterval(S.tick); }
function elapsed(){ return Date.now() - S.started; }

/* ---------------- part one rendering ---------------- */
function polar(cx,cy,r,deg){ return [cx+r*Math.cos(rad(deg)), cy+r*Math.sin(rad(deg))]; }
function arcPath(cx,cy,r,a0,a1){
  var p0 = polar(cx,cy,r,a0), p1 = polar(cx,cy,r,a1);
  var big = (a1-a0) > 180 ? 1 : 0;
  return 'M'+p0[0].toFixed(1)+' '+p0[1].toFixed(1)+' A'+r+' '+r+' 0 '+big+' 1 '+p1[0].toFixed(1)+' '+p1[1].toFixed(1);
}

function buildDial(d){
  var CX=260, CY=248, R=176;
  var s = '<svg viewBox="0 0 520 470" role="group" aria-label="'+d.n+' dial">';
  /* bezel */
  s += '<circle cx="'+CX+'" cy="'+CY+'" r="'+(R+34)+'" fill="#0d131b" stroke="#1d2b39" stroke-width="2"/>';
  s += '<circle cx="'+CX+'" cy="'+CY+'" r="'+(R+16)+'" fill="#111925" stroke="#26374a" stroke-width="1.5"/>';

  var slots = [];
  if(d.t === 'arc'){
    /* 240° scale, opening downward */
    s += '<path d="'+arcPath(CX,CY,R-6,150,390)+'" fill="none" stroke="#22303f" stroke-width="3"/>';
    for(var i=0;i<4;i++){
      var a = 150 + (i*240)/3;
      slots.push({a:a, txt:String(d.o[i])});
    }
  } else {
    /* full 360 crank wheel */
    s += '<circle cx="'+CX+'" cy="'+CY+'" r="'+(R-6)+'" fill="none" stroke="#22303f" stroke-width="3"/>';
    /* degree graticule: 0 at top, clockwise */
    for(var g=0; g<360; g+=15){
      var ga = g - 90, maj = (g%90===0);
      var q1 = polar(CX,CY,R-6,ga), q2 = polar(CX,CY,R-(maj?24:14),ga);
      s += '<line x1="'+q1[0].toFixed(1)+'" y1="'+q1[1].toFixed(1)+'" x2="'+q2[0].toFixed(1)+'" y2="'+q2[1].toFixed(1)
        +  '" stroke="'+(maj?'#4b6274':'#2a3947')+'" stroke-width="'+(maj?2:1)+'"/>';
      if(maj){
        var qt = polar(CX,CY,R-40,ga);
        s += '<text x="'+qt[0].toFixed(1)+'" y="'+(qt[1]+4).toFixed(1)+'" text-anchor="middle" '
          +  'font-family="Share Tech Mono, monospace" font-size="12" fill="#4b6274">'+g+'</text>';
      }
    }
    for(var j=0;j<4;j++){
      var v = d.o[j];
      var mid = (v instanceof Array) ? (v[0]+v[1])/2 : v;
      slots.push({a: mid-90, txt:(v instanceof Array ? v[0]+'°–'+v[1]+'°' : v+'°'), span:(v instanceof Array?v:null)});
    }
  }

  /* option markers */
  for(var k=0;k<4;k++){
    var sl = slots[k];
    var tip  = polar(CX,CY,R-6,sl.a);
    var seat = polar(CX,CY,R-4,sl.a);
    var lab  = polar(CX,CY,R+46,sl.a);
    var anchor = Math.abs(Math.cos(rad(sl.a))) < .32 ? 'middle' : (Math.cos(rad(sl.a))>0 ? 'start':'end');
    var dy = Math.sin(rad(sl.a)) > .5 ? 12 : (Math.sin(rad(sl.a)) < -.5 ? -4 : 5);

    s += '<g class="detent" data-i="'+k+'" tabindex="0" role="button" aria-label="'+sl.txt+'">';
    if(sl.span){
      s += '<path class="dspan" d="'+arcPath(CX,CY,R-6,sl.span[0]-90,sl.span[1]-90)+'" fill="none" '
        +  'stroke="#3e5568" stroke-width="9" stroke-linecap="round"/>';
    }
    s += '<circle class="dbox" cx="'+seat[0].toFixed(1)+'" cy="'+seat[1].toFixed(1)+'" r="11" fill="#16202b" stroke="#3e5568" stroke-width="2"/>';
    s += '<circle class="ddot" cx="'+seat[0].toFixed(1)+'" cy="'+seat[1].toFixed(1)+'" r="3.5" fill="#3e5568"/>';
    s += '<text class="dlab" x="'+lab[0].toFixed(1)+'" y="'+(lab[1]+dy).toFixed(1)+'" text-anchor="'+anchor+'" '
      +  'font-family="Share Tech Mono, monospace" font-size="14" fill="#9aa7b3">'+sl.txt+'</text>';
    s += '<circle class="dtouch" cx="'+tip[0].toFixed(1)+'" cy="'+tip[1].toFixed(1)+'" r="30" fill="transparent" pointer-events="all"/>';
    s += '</g>';
  }

  /* needle */
  s += '<g class="needle" style="transform-origin:'+CX+'px '+CY+'px;transition:transform .5s cubic-bezier(.25,1.3,.4,1)">'
    +  '<path d="M'+CX+' '+CY+' l-6 -8 L'+CX+' '+(CY-R+16)+' l6 8 Z" fill="#ebe7dd" opacity=".92"/>'
    +  '<line x1="'+CX+'" y1="'+CY+'" x2="'+CX+'" y2="'+(CY-R+16)+'" stroke="#ebe7dd" stroke-width="2.5" stroke-linecap="round"/>'
    +  '</g>';
  s += '<circle cx="'+CX+'" cy="'+CY+'" r="15" fill="#0f151d" stroke="#5d7183" stroke-width="2"/>';
  s += '<circle cx="'+CX+'" cy="'+CY+'" r="5" fill="#5d7183"/>';

  /* face text */
  s += '<text x="'+CX+'" y="'+(CY+62)+'" text-anchor="middle" font-family="Barlow Condensed, sans-serif" '
    +  'font-weight="600" font-size="18" letter-spacing="3" fill="#6f7c8a">'+d.n.toUpperCase()+'</text>';
  s += '<text x="'+CX+'" y="'+(CY+86)+'" text-anchor="middle" font-family="Share Tech Mono, monospace" '
    +  'font-size="12" letter-spacing="2" fill="#d9a44b">'+d.u+'</text>';
  return s+'</svg>';
}

function needleAngleFor(d, idx){
  if(d.t === 'arc') return -120 + idx*80;          /* 150..390 mapped, needle 0 = up */
  var v = d.o[idx];
  var mid = (v instanceof Array) ? (v[0]+v[1])/2 : v;
  return mid;                                       /* crank 0 = up, clockwise */
}

function p1Question(){
  if(S.q >= DIALS.length){ return toIntermission(); }
  var d = DIALS[S.q];
  S.locked = false;
  $('#p1label').textContent = 'Setting ' + (S.q+1) + ' of ' + DIALS.length;
  $('#p1term').textContent = d.n;
  $('#p1sub').textContent = d.q;
  var host = $('#dialhost');
  host.innerHTML = buildDial(d);
  var note = $('#n1');
  note.className = 'note';
  note.textContent = 'Turn the dial to the correct value.';

  var gs = host.querySelectorAll('.detent');
  Array.prototype.forEach.call(gs, function(g){
    g.addEventListener('click', function(){ p1Answer(parseInt(g.dataset.i,10)); });
    g.addEventListener('keydown', function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); p1Answer(parseInt(g.dataset.i,10)); }
    });
  });
  runTimer('#t1', T1, function(){ p1Answer(-1); });
}

function markDetent(host, idx, colour){
  var g = host.querySelectorAll('.detent')[idx];
  if(!g) return;
  g.classList.add('locked');
  var b = g.querySelector('.dbox'), dot = g.querySelector('.ddot'),
      lab = g.querySelector('.dlab'), sp = g.querySelector('.dspan');
  if(b){ b.setAttribute('stroke', colour); b.setAttribute('fill','#16202b'); }
  if(dot) dot.setAttribute('fill', colour);
  if(lab) lab.setAttribute('fill', colour);
  if(sp) sp.setAttribute('stroke', colour);
}

function p1Answer(idx){
  if(S.locked) return;
  S.locked = true;
  stopTimer();
  var d = DIALS[S.q], host = $('#dialhost'), note = $('#n1');
  var right = (idx === d.c);
  var ndl = host.querySelector('.needle');

  if(idx >= 0 && ndl) ndl.style.transform = 'rotate('+needleAngleFor(d, idx).toFixed(1)+'deg)';
  if(!right && ndl) setTimeout(function(){
    if(ndl) ndl.style.transform = 'rotate('+needleAngleFor(d, d.c).toFixed(1)+'deg)';
  }, 480);

  var chosen = (idx<0) ? '—' : String(d.o[idx] instanceof Array ? d.o[idx][0]+'–'+d.o[idx][1] : d.o[idx]);
  var answer = String(d.o[d.c] instanceof Array ? d.o[d.c][0]+'°–'+d.o[d.c][1]+'°' : d.o[d.c]) + (d.t==='crank' && !(d.o[d.c] instanceof Array) ? '°' : '');

  if(right){
    var snap = elapsed() < SNAP;
    bumpEff(snap ? 12 : 4);
    markDetent(host, idx, '#7fd68a');
    note.className = 'note good';
    note.textContent = d.k + (snap ? '  ·  Snap bonus.' : '');
    logChip(d.n, answer, true);
  } else {
    bumpEff(idx<0 ? -14 : -12);
    if(idx>=0) markDetent(host, idx, '#d94f36');
    markDetent(host, d.c, '#7fd68a');
    note.className = 'note bad';
    note.textContent = (idx<0 ? 'Ran out. ' : 'Set to ' + chosen + '. ') + d.k;
    logChip(d.n, answer, false);
    S.misses.push({w:'Part 1', n:d.n, k:d.k});
  }
  if(S.eff <= 0) return setTimeout(function(){ endGame(false); }, 1500);
  S.q++;
  setTimeout(p1Question, right ? 1750 : 2600);
}

function logChip(name, val, ok){
  var row = ce('div');
  row.className = 'chip ' + (ok ? 'hit' : 'miss');
  row.innerHTML = '<span>'+name+'</span><b>'+val+'</b>';
  $('#p1log').appendChild(row);
  $('#p1log').parentNode.scrollTop = 9e5;
}
